# Copy this file to apps/web/.env and fill in real values.
# Never commit an actual .env file. Any value left blank means that
# feature must show an "unavailable / not configured" state, not fake data.
#
# The frontend talks directly to Supabase (auth + farm data, protected by
# row-level security) and directly to n8n webhooks (AI/agent orchestration,
# authenticated by forwarding the farmer's Supabase JWT — n8n verifies it,
# no separate backend service sits in between). See docs/architecture.md.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local Docker n8n, or your n8n Cloud instance root (no trailing slash) —
# e.g. https://<your-instance>.app.n8n.cloud. callAgentWebhook() appends
# /webhook/<path>, so the Crop Diagnosis API is <base>/webhook/crop-diagnosis.
VITE_N8N_BASE_URL=http://localhost:5678

# External data source keys (weather, market, vision, translation/voice)
# live only inside services/n8n/.env — the frontend never holds them.
