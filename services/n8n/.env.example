# Copy to .env in this folder before running docker compose up.
# Basic-auth protects the local n8n editor UI; not needed in production
# if n8n sits behind its own auth/VPN.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=

# External data source credentials used by the agent workflows below.
# See /.env.example at the repo root for the full list and where each
# one is used.
OPENWEATHERMAP_API_KEY=
DATA_GOV_IN_API_KEY=
BHASHINI_API_KEY=
GOOGLE_CLOUD_API_KEY=

# Crop Diagnosis (Roboflow, plantdoc-sp73n/7) is NOT an env var here on
# purpose: ROBOFLOW_API_KEY is stored as an n8n Credential (HTTP Header
# Auth: header "Authorization", value "Bearer <key>") created directly in
# n8n's Credentials store, never in this file, so it can never end up
# committed to the repo. See services/n8n/README.md.

# Used by the Crop Diagnosis Agent's webhook wrapper to verify the
# farmer's forwarded Supabase JWT (GET /auth/v1/user). Only the anon
# key is needed here — never the service-role key; n8n never writes to
# Supabase for this feature, the frontend does (see docs/architecture.md).
SUPABASE_URL=
SUPABASE_ANON_KEY=
